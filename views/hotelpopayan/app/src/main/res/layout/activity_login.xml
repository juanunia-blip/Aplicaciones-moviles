<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_header"
        app:layout_constraintHeight_percent="0.30"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="1">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo_hotel"
            android:scaleType="fitCenter"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hotel Popayán"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guía turística inteligente"
            android:textColor="#FFFFFF"
            android:textSize="11sp"/>

    </LinearLayout>

    <!-- CARD (FLOTANTE Y CENTRADA) -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- SCROLL -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="34dp">

                <!-- TITULO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡BIENVENIDO!"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1E4E8C"/>

                <!-- SUBTITULO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descubre Popayán, reserva y vive la experiencia."
                    android:layout_marginTop="6dp"/>

                <!-- EMAIL -->
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Correo electrónico"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"/>

                <!-- PASSWORD -->
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Contraseña"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:inputType="textPassword"/>

                <!-- RECUPERAR -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Olvidaste tu contraseña?"
                    android:textColor="#1E4E8C"
                    android:layout_marginTop="10dp"/>

                <!-- BOTON -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Iniciar sesión"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_button"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/tvRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿No tienes cuenta? Regístrate"
                    android:layout_marginTop="16dp"
                    android:textColor="#1E4E8C"
                    android:layout_gravity="center"/>

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>